# 银洲汇合信息供需平台 · 环境变量示例
# 复制为 .env 后按需填写，不填则走默认值

# MongoDB Atlas 连接串（可选，不配则使用内存存储，重启清空）
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/supply_board?retryWrites=true&w=majority

# 微信登录（可选，不配则走演示 mock）
# WECHAT_APPID=your_appid
# WECHAT_SECRET=your_secret

# JWT 签名密钥（可选）
# JWT_SECRET=your_random_secret

# 服务端口（可选，默认 3000）
# PORT=3000
